{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "extends": [
    "default",
    "github-tools",
    "jeera-tool",
    "plannotator-tool"
  ],
  "meta": {
    "name": "agent-common",
    "version": "0.1.0",
    "description": "Shared daily-driver capabilities for local coding agents"
  },
  "groups": {
    "include": [
      "mise_manager",
      "node_runtime",
      "rust_runtime",
      "go_runtime",
      {
        "name": "go_runtime_macos",
        "when": "macos"
      },
      {
        "name": "go_runtime_linux",
        "when": "linux"
      },
      "python_runtime",
      "bun_runtime",
      "git_config"
    ]
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "$HOME/.cache/checkouts",
      "$HOME/.config/gh",
      "$HOME/.local/state/mise/tracked-configs",
      "$HOME/.yarn/berry/cache",
      "$HOME/OneDrive - Gannett Company, Incorporated/obsidian/work"
    ],
    "read": [
      "$HOME/.local/state/mise/trusted-configs",
      "$HOME/.config/yarn",
      "$HOME/.claude/skills"
    ],
    "read_file": [
      "$HOME/.config/dev-common.json",
      "$HOME/.dotfiles/dots/.config/delta/themes.gitconfig",
      "$HOME/.gitignore.global",
      "$HOME/.local.gitconfig",
      "$HOME/.npmrc",
      "$HOME/.yarnrc",
      "$HOME/.yarnrc.yml"
    ],
    "bypass_protection": [
      "$HOME/.npmrc"
    ],
    "unix_socket": [
      "$HERDR_SOCKET_PATH"
    ]
  },
  "network": {
    "block": false,
    "network_profile": null
  }
}
