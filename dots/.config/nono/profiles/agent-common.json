{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "extends": [
    "default",
    "github-tools",
    "jeera-tool",
    "plannotator-tool"
  ],
  "meta": {
    "name": "agent-common",
    "version": "0.1.0",
    "description": "Shared daily-driver capabilities for local coding agents"
  },
  "groups": {
    "include": [
      "mise_manager",
      "node_runtime",
      "rust_runtime",
      "go_runtime",
      {
        "name": "go_runtime_macos",
        "when": "macos"
      },
      {
        "name": "go_runtime_linux",
        "when": "linux"
      },
      "python_runtime",
      "bun_runtime",
      "git_config"
    ]
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "$HOME/.local/state/mise/tracked-configs"
    ],
    "read": [
      "$HOME/.local/state/mise/trusted-configs",
      "$HOME/.config/yarn"
    ],
    "read_file": [
      "$HOME/.yarnrc",
      "$HOME/.yarnrc.yml"
    ],
    "unix_socket": [
      "$HERDR_SOCKET_PATH"
    ]
  },
  "network": {
    "block": false,
    "network_profile": null,
    "tls_intercept": {
      "ca_lifecycle": "trusted",
      "ca_validity": "24h",
      "leaf_validity": "15m"
    }
  }
}
