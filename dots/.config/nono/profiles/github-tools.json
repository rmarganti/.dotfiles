{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "meta": {
    "name": "github-tools",
    "version": "0.2.0",
    "description": "Brokered GitHub credential and command policy for gh"
  },
  "network": {
    "tls_intercept": {
      "ca_lifecycle": "trusted",
      "ca_validity": "24h",
      "leaf_validity": "15m"
    }
  },
  "command_policies": {
    "credentials": {
      "github-api": {
        "type": "proxy",
        "upstream": "https://api.github.com",
        "credential_key": "keyring://gh:github.com/rmarganti?decode=go-keyring",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    },
    "commands": {
      "gh": {
        "executable": "/opt/homebrew/bin/gh",
        "from": {
          "session": {
            "sandbox": {
              "credentials": [
                {
                  "name": "github-api",
                  "endpoint_policy": {
                    "default": "allow",
                    "deny": [
                      {
                        "method": "DELETE",
                        "path": "/repos/*/*",
                        "reason": "Repository deletion is denied"
                      },
                      {
                        "method": "*",
                        "path": "/repos/*/*/actions/secrets/**",
                        "reason": "Repository secret administration is denied"
                      },
                      {
                        "method": "*",
                        "path": "/repos/*/*/actions/variables/**",
                        "reason": "Repository variable administration is denied"
                      },
                      {
                        "method": "*",
                        "path": "/repos/*/*/keys/**",
                        "reason": "Deploy-key administration is denied"
                      },
                      {
                        "method": "*",
                        "path": "/user/keys/**",
                        "reason": "Account SSH-key administration is denied"
                      },
                      {
                        "method": "*",
                        "path": "/user/gpg_keys/**",
                        "reason": "Account GPG-key administration is denied"
                      }
                    ]
                  }
                }
              ],
              "fs_read": [
                ".",
                "/opt/homebrew"
              ],
              "fs_read_file": [
                "$HOME/.config/gh/hosts.yml",
                "$HOME/.config/gh/config.yml",
                "$HOME/.CFUserTextEncoding",
                "/opt/homebrew/bin/gh"
              ],
              "fs_write": [
                "."
              ],
              "environment": {
                "allow_vars": [
                  "PATH",
                  "HOME",
                  "LANG",
                  "LC_*",
                  "TERM",
                  "TMPDIR",
                  "GH_TOKEN",
                  "GITHUB_TOKEN",
                  "GH_HOST",
                  "GH_REPO",
                  "GH_CONFIG_DIR",
                  "HTTP_PROXY",
                  "HTTPS_PROXY",
                  "NO_PROXY",
                  "http_proxy",
                  "https_proxy",
                  "no_proxy",
                  "NONO_PROXY_TOKEN",
                  "SSL_CERT_FILE",
                  "REQUESTS_CA_BUNDLE",
                  "NODE_EXTRA_CA_CERTS",
                  "CURL_CA_BUNDLE",
                  "GIT_SSL_CAINFO"
                ],
                "set_vars": {
                  "GH_PROMPT_DISABLED": "1",
                  "GH_NO_UPDATE_NOTIFIER": "1"
                }
              },
              "stdio": {
                "stdout": {
                  "max_bytes": 1048576,
                  "on_limit": "truncate"
                },
                "stderr": {
                  "max_bytes": 262144,
                  "on_limit": "truncate"
                }
              }
            },
            "invocation_policy": {
              "default": "allow",
              "deny": [
                {
                  "argv": {
                    "exact": [
                      "auth",
                      "token"
                    ]
                  },
                  "reason": "Credential output is unavailable to coding agents"
                },
                {
                  "argv": {
                    "prefix": [
                      "repo",
                      "delete"
                    ]
                  },
                  "reason": "Repository deletion is denied"
                },
                {
                  "argv": {
                    "prefix": [
                      "secret"
                    ]
                  },
                  "reason": "Secret administration is denied"
                },
                {
                  "argv": {
                    "prefix": [
                      "variable"
                    ]
                  },
                  "reason": "Variable administration is denied"
                },
                {
                  "argv": {
                    "prefix": [
                      "ssh-key"
                    ]
                  },
                  "reason": "Account SSH-key administration is denied"
                },
                {
                  "argv": {
                    "prefix": [
                      "gpg-key"
                    ]
                  },
                  "reason": "Account GPG-key administration is denied"
                }
              ]
            }
          }
        }
      }
    }
  }
}
